{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:prisma": "prisma generate",
    "dev": "npm run generate:prisma && next dev --turbopack",
    "build": "npm run generate:prisma && next build",
    "vercel-build": "npm run generate:prisma && NEXT_FAST_BUILD=1 next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern next-env.d.ts",
    "typecheck": "npm run generate:prisma && next typegen && tsc -p tsconfig.typecheck.json --noEmit --incremental false",
    "test": "vitest run",
    "backfill:kick-streamers": "tsx scripts/backfill-kick-streamer-metadata.ts",
    "backfill:twitch-streamers": "tsx scripts/backfill-twitch-streamer-metadata.ts",
    "backfill:source-published-at": "tsx scripts/backfill-source-published-at.ts",
    "bootstrap:twitch-session": "tsx ../playwright/local/bootstrap-twitch-session.ts",
    "bootstrap:twitch-session:manual": "TWITCH_BROWSER_WS_ENDPOINT=http://127.0.0.1:9223 tsx ../playwright/local/bootstrap-twitch-session.ts --manual-login"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1019.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "7.7.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@scalar/nextjs-api-reference": "^0.10.6",
    "@sparticuz/chromium": "^143.0.4",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.577.0",
    "mediabunny": "^1.40.1",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "playwright-core": "^1.58.2",
    "prisma": "7.7.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "resend": "^6.10.0",
    "sonner": "^2.0.7",
    "stripe": "^20.4.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.2.1",
    "jsdom": "29.0.2",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.60.0",
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.1",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
