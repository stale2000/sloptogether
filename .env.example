# Vercel uses Supabase's IPv4 transaction pooler; replace the project ref/password.
# Use a scoped role username of sloptogether_app.<project-ref>, not postgres.<project-ref>.
DATABASE_URL=postgresql://sloptogether_app.<project-ref>:<password>@aws-1-us-east-2.pooler.supabase.com:6543/postgres?sslmode=require
# true only when DATABASE_URL points to the shared Clips.gg project and scoped login.
SLOPTOGETHER_USE_CLIPSGG_DATABASE=false
# Download prod-ca-2021.crt from Supabase's official database SSL certificate endpoint.
SLOPTOGETHER_DATABASE_SSL_CA=
PUBLIC_APP_URL=https://www.clips.gg/sloptogether
NEXT_PUBLIC_LOCAL_DEMO_ENABLED=false
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=
TWITCH_EVENTSUB_SECRET_PREVIOUS=
TWITCH_EVENTSUB_CALLBACK_URL=https://www.clips.gg/sloptogether/api/v1/webhooks/eventsub
SLOPTOGETHER_TOKEN_ENCRYPTION_KEY=
SLOPTOGETHER_KEY_HASH_PEPPER=
SLOPTOGETHER_PROXY_CLIENT_IP_SECRET=
SLOPTOGETHER_UPLOAD_TICKET_KEY=
SLOPTOGETHER_UPLOAD_GATEWAY_SECRET=
SLOPTOGETHER_UPLOAD_WORKER_ORIGIN=
TWITCH_EXTENSION_CLIENT_ID=
TWITCH_EXTENSION_CLIENT_SECRET=
TWITCH_EXTENSION_SECRET_CURRENT=
TWITCH_EXTENSION_SECRET_PREVIOUS=
# Free text/image moderation key used only by server preflight and final-frame checks.
SLOPTOGETHER_OPENAI_MODERATION_KEY=
# Optional paid prompt/story generation key; keep it in the owner story worker only.
OPENAI_API_KEY=
# Optional owner-only Comfy Cloud prompt/frame generation; each explicit request spends Comfy credits.
SLOPTOGETHER_COMFY_FRAME_GENERATION_ENABLED=false
SLOPTOGETHER_COMFY_PROMPT_GENERATION_ENABLED=false
SLOPTOGETHER_COMFY_API_KEY=
SLOPTOGETHER_COMFY_FRAME_GENERATION_CHANNEL_IDS=
# Keep the paid provider key in the supervised media worker's secret environment.
FAL_KEY=
SLOPTOGETHER_BITS_TURBO_ENABLED=false
SLOPTOGETHER_BITS_POLICY_APPROVED=false
SLOPTOGETHER_BITS_EVENTSUB_READY=false
SLOPTOGETHER_BITS_PROMPT_LOCK_ENABLED=false
SLOPTOGETHER_BITS_PROMPT_LOCK_POLICY_APPROVED=false
SLOPTOGETHER_BITS_PROMPT_LOCK_EVENTSUB_READY=false
SLOPTOGETHER_BITS_PROMPT_LOCK_DISPATCH_READY=false
SLOPTOGETHER_BITS_PROMPT_LOCK_PRODUCTS_JSON=
SLOPTOGETHER_BITS_DISPATCH_READY=false
SLOPTOGETHER_BITS_TURBO_PRODUCTS_JSON=
# Share only between the web API and supervised media worker.
SLOPTOGETHER_BITS_RECONCILE_SECRET=
# Shared web/worker URL; must use PUBLIC_APP_URL plus /api/v1/internal/bits/reconcile.
SLOPTOGETHER_BITS_RECONCILE_URL=
WINDOWS_WORKER_VERSION=
WINDOWS_WORKER_DOWNLOAD_URL=
WINDOWS_WORKER_SHA256=
WINDOWS_WORKER_RELEASED_AT=
WINDOWS_WORKER_BUILD=
WINDOWS_WORKER_ROLES=
WINDOWS_WORKER_QUALIFIED_GPUS=
NEXT_PUBLIC_MEDIA_ORIGINS=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Development only; must be a loopback HTTP S3 endpoint. Never set in production.
SLOPTOGETHER_LOCAL_S3_ENDPOINT=
R2_UPLOAD_WORKER_ORIGIN=
OUTPUT_PUBLIC_ORIGIN=
# Per-subscriber-interrupt owner-budget reservation; blank disables subscriber-funded renders.
SLOPTOGETHER_SUBSCRIBER_ATTEMPT_RESERVATION_USD=
# Per-story owner-budget reservation; blank disables owner-funded story renders.
SLOPTOGETHER_GENERATION_ATTEMPT_RESERVATION_USD=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_VALIDATOR_POLL_MS=1500
MEDIA_VALIDATOR_MAX_BYTES=134217728
MEDIA_VALIDATOR_MIN_SECONDS=13
MEDIA_VALIDATOR_MAX_SECONDS=17
